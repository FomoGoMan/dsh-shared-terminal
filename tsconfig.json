{
	"compilerOptions": {
		"target": "ES2024",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2024"],
		"strict": true,
		"skipLibCheck": true,
		"noUncheckedIndexedAccess": true,
		"verbatimModuleSyntax": true,
		"declaration": true,
		"types": ["node"]
	},
	"include": ["src/**/*.ts", "tsdown.config.ts"]
}
